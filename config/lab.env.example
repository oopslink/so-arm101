# Copy to lab.env and edit. No credentials belong in this file.
export ROBOT_PROJECT_ROOT=/path/to/so-arm101
export ROBOT_LEROBOT_ROOT=/path/to/lerobot
export ROBOT_DATA_ROOT="$ROBOT_LEROBOT_ROOT/datasets"
export ROBOT_MODEL_ROOT="$ROBOT_LEROBOT_ROOT/models"
# Backward-compatible name used by collection scripts.
export LAB_ROOT="$ROBOT_LEROBOT_ROOT"
export HF_USER=YOUR_HF_USERNAME
export BASE_REPO_ID="$HF_USER/qiaomuyu_demo"
export BASE_DATASET_ROOT="$LAB_ROOT/datasets/qiaomuyu_demo"
export MERGED_ROOT="$LAB_ROOT/datasets/qiaomuyu_80"
export DATASET_REPO_ID="$HF_USER/qiaomuyu_80"
export MODEL_REPO_ID="$HF_USER/qiaomuyu_pi0"
export MODEL_ROOT="$LAB_ROOT/models/qiaomuyu_pi0"
# The following serial numbers are from this experiment; replace for another kit.
export FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79080311-if00
export LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79080006-if00
export FOLLOWER_ID=oopslink_follower_arm
export LEADER_ID=oopslink_leader_arm
export WRIST_CAMERA=/dev/v4l/by-id/usb-icSpring_icspring_camera_20240307110322-video-index0
export SIDE_CAMERA=/dev/v4l/by-id/usb-SN0002_1080P_USB_Camera_44434000_P030C01_SN0002-video-index0
export CAMERAS="{wrist: {type: opencv, index_or_path: '$WRIST_CAMERA', width: 1920, height: 1080, fps: 30, fourcc: MJPG}, side: {type: opencv, index_or_path: '$SIDE_CAMERA', width: 1920, height: 1080, fps: 30, fourcc: MJPG}}"
export TASK='Find the orange wooden fish, pick up the mallet by its handle, tap the wooden fish exactly three times, return the mallet to its holder, and return the arm to its home pose.'
