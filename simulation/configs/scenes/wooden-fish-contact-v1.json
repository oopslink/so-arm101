{
  "schema_version": 1,
  "id": "wooden-fish-contact-v1",
  "version": "1.0.0",
  "title": "SO-101 木鱼接触抓握场景",
  "description": "使用真实接触完成夹紧、提起、单次敲击、抬起和释放的 MuJoCo 工程场景。",
  "engine": "mujoco",
  "kind": "contact_grasp",
  "status": "partial_task_validation",
  "assets": {
    "robot_model": "assets/so101/so101_new_calib.xml",
    "tabletop_config": "configs/tabletop-reference.json",
    "physics_config": "configs/grasp-physics.json"
  },
  "robot": {
    "name": "SO-101",
