    "not_implemented_phases": ["视觉寻找", "从底板接近并抓取", "连续敲三下", "放回原位", "回位"]
  },
  "randomization": {
    "fish_xy_metres": 0.005,
    "joint_start_radians": 0.003
  },
  "success_criteria": {
    "requires_contact_only_grasp": true,
    "minimum_lift_metres": 0.025,
    "maximum_relative_drift_metres": 0.005,
    "minimum_release_drop_metres": 0.05,
    "required_hits": 1
